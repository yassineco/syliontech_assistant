rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Règles pour les admins SylionTech uniquement
    match /adminUsers/{userId} {
      allow read, write: if request.auth != null && 
        request.auth.token.email in ['admin@syliontech.com', 'yassine@syliontech.com'];
    }
    
    // Règles multi-tenant - accès par tenant
    match /tenants/{tenantId} {
      allow read, write: if request.auth != null && 
        request.auth.token.email in ['admin@syliontech.com', 'yassine@syliontech.com'];
      
      // Documents RAG par tenant
      match /ragDocuments/{docId} {
        allow read, write: if request.auth != null;
        
        // Chunks des documents
        match /chunks/{chunkId} {
          allow read, write: if request.auth != null;
        }
      }
      
      // Autres collections du tenant
      match /apiKeys/{keyId} {
        allow read, write: if request.auth != null;
      }
      
      match /usage/{usageId} {
        allow read, write: if request.auth != null;
      }
    }
    
    // Déni par défaut
    match /{document=**} {
      allow read, write: if false;
    }
  }
}